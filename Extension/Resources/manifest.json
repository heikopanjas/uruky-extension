{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "__MSG_extensionName__",
  "description": "__MSG_extensionDescription__",
  "version": "1.0",

  "icons": {
    "48": "images/icon-48.png",
    "96": "images/icon-96.png",
    "128": "images/icon-128.png",
    "256": "images/icon-256.png",
    "512": "images/icon-512.png"
  },

  "permissions": [
    "declarativeNetRequestWithHostAccess",
    "webNavigation",
    "storage"
  ],

  "host_permissions": [
    "*://*.google.com/*",
    "*://*.google.de/*",
    "*://*.google.ch/*",
    "*://*.google.at/*",
    "*://*.google.co.uk/*",
    "*://*.google.fr/*",
    "*://*.google.it/*",
    "*://*.google.es/*",
    "*://*.google.nl/*",
    "*://duckduckgo.com/*",
    "*://*.bing.com/*",
    "*://*.ecosia.org/*",
    "*://*.search.yahoo.com/*",
    "*://uruky.com/*"
  ],

  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "default",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },

  "background": {
    "service_worker": "background.js"
  },

  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
